---
import type { FaqItem } from '~/data/faq';

interface Props {
  vragen: FaqItem[];
  kop?: string;
}

const { vragen, kop = 'De vragen die je toch ging stellen' } = Astro.props;

/**
 * details en summary: open- en dichtklappen, toetsenbordbediening en de
 * juiste rol voor screenreaders, allemaal vanuit de browser. Nul JavaScript.
 *
 * De naam-attributen zijn bewust weggelaten: als je één vraag opent mag een
 * andere openblijven. Iemand die twijfelt wil vaak twee antwoorden naast elkaar.
 */
---

<section class="sectie border-t border-line">
  <div class="container-vp">
    <p class="comment-mono op-scroll"><span class="text-mint-dim">//</span> eerlijke antwoorden, ook de lastige</p>

    <h2 class="op-scroll mt-5 max-w-2xl text-3xl sm:text-4xl md:text-5xl">{kop}</h2>

    <div class="mt-12 max-w-3xl">
      {
        vragen.map((item) => (
          <details class="vraag op-scroll group border-t border-line last:border-b">
            {/* summary mag precies één heading bevatten. Goed voor de
                koppenstructuur en voor AI die de vraag wil herkennen. */}
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 transition-colors hover:text-mint">
              <h3 class="text-lg leading-snug font-normal md:text-xl">{item.vraag}</h3>
              <span
                class="mt-1 shrink-0 text-faint transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path
                    d="M9 3.5v11M3.5 9h11"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>
            <p class="max-w-2xl pb-6 leading-relaxed text-muted">{item.antwoord}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Safari toont anders zijn eigen driehoekje naast het onze. */
  .vraag summary::-webkit-details-marker {
    display: none;
  }

  /* Open- en dichtklappen zonder sprong. Alleen ondersteund waar
     interpolate-size bestaat, elders klapt het gewoon direct open. */
  @supports (interpolate-size: allow-keywords) {
    .vraag::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 260ms var(--ease-uit),
        content-visibility 260ms allow-discrete;
    }

    .vraag[open]::details-content {
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vraag::details-content {
      transition: none !important;
    }
    .vraag summary span {
      transition: none !important;
    }
  }
</style>
