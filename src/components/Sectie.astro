---
/**
 * De schil van een sectie. Bezit de regel bovenaan, de container en het grid.
 *
 * Waarom dit een component is en geen kopie-en-plak: de layout van de site is
 * een zichtbaar constructieraster, en dan moet elke sectie op exact dezelfde
 * lijnen vallen. Eén sectie die zijn eigen padding of goot kiest, breekt het
 * raster, en dat is meteen te zien. Hier staat het één keer.
 *
 * De goot links draagt het sectienummer en het mono-commentaar. Die goot is de
 * asymmetrie: de inhoud begint niet aan de linkerrand maar een kolom verder, en
 * het nummer loopt mee terwijl je door de sectie scrollt.
 */

interface Props {
  /** Twee cijfers, doorlopend over de pagina. Wordt niet automatisch geteld,
   *  want secties staan niet altijd in dezelfde volgorde op elke pagina. */
  nr: string;
  /** Het `// commentaar` boven de sectie. Zonder de slashes, die zet ik hier. */
  comment: string;
  /** sectie is de standaard. krap voor korte secties, ruim voor een brandpunt.
   *  Zie de spacing-regel in CLAUDE.md deel 3. */
  ritme?: 'sectie' | 'sectie-krap' | 'sectie-ruim';
  /** De bovenste sectie van een pagina heeft geen regel nodig, want de nav
   *  levert daar al een lijn. */
  regel?: boolean;
  /** Voor een anker uit de nav of de command palette. */
  id?: string;
}

const { nr, comment, ritme = 'sectie', regel = true, id } = Astro.props;
---

<section id={id} class:list={[ritme, regel && 'border-t border-line']}>
  <div class="container-vp">
    <div class="sectie-grid">
      <div class="sectie-goot">
        <p class="op-scroll flex items-baseline gap-3 font-mono text-xs lg:flex-col lg:gap-1.5">
          <span class="text-mint-dim">{nr}</span>
          <span class="text-faint lg:hidden">{comment}</span>
        </p>
      </div>

      <div>
        <!-- Op lg staat het commentaar in de inhoudkolom en niet in de goot:
             daar is het maar 5,5rem breed en dan breekt elke zin in vijf regels.
             Het nummer blijft wel in de goot staan. -->
        <p class="comment-mono op-scroll hidden lg:block">
          <span class="text-mint-dim">//</span> {comment}
        </p>

        <slot />
      </div>
    </div>
  </div>
</section>
