---
interface Props {
  comment: string;
  titel: string;
  intro?: string;
  kruimels?: Array<{ naam: string; pad: string }>;
}

const { comment, titel, intro, kruimels = [] } = Astro.props;
---

<section class="relative overflow-hidden border-b border-line">
  <div class="kop-raster" aria-hidden="true"></div>

  <div class="container-vp relative pt-10 pb-12 md:pt-14 md:pb-16">
    {
      kruimels.length > 0 && (
        <nav aria-label="Kruimelpad" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-faint">
            <li>
              <a href="/" class="inline-flex min-h-11 items-center hover:text-muted">
                home
              </a>
            </li>
            {kruimels.map((kruimel, i) => (
              <>
                <li aria-hidden="true" class="text-line-soft">
                  /
                </li>
                <li>
                  {i === kruimels.length - 1 ? (
                    <span class="text-muted" aria-current="page">
                      {kruimel.naam}
                    </span>
                  ) : (
                    <a href={kruimel.pad} class="inline-flex min-h-11 items-center hover:text-muted">
                      {kruimel.naam}
                    </a>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )
    }

    <!-- Was een `// commentaar` in mono. Zelfde reden als in de hero: mono maakt
         van een zin een terminalregel, en dat is de vibe die eraf moest. Nu een
         streepje met een woord ernaast, net als bij elk blok op de home. -->
    <p class="flex items-center gap-3 text-sm text-mint">
      <span class="h-px w-8 bg-mint/40" aria-hidden="true"></span>
      {comment}
    </p>

    <h1 class="kop-kaart mt-6 max-w-4xl">
      {titel}
    </h1>

    {intro && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{intro}</p>}

    <slot />
  </div>
</section>

<style>
  /* Uit fg gemengd, dus dit werkt in beide weergaven zonder override.
     Zelfde aanpak als in Hero.astro. */
  .kop-raster {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-fg) 12%, transparent) 1px,
      transparent 1px
    );
    background-size: 2.25rem 2.25rem;
    mask-image: radial-gradient(42rem 22rem at 20% 0%, #000 0%, transparent 76%);
  }
</style>
