---
/**
 * Een tegel op het bord.
 *
 * Dit vervangt de sectie-in-een-band. De home was een verticale stapel volle
 * banden, en dat is wat een marketingpagina doet. Een tegel met een eigen kop
 * en een eigen kader leest als een paneel in een toepassing: je scant het bord
 * en klikt door naar wat je nodig hebt, in plaats van alles van boven naar
 * onder te lezen.
 *
 * Dat past ook beter bij wat deze site verkoopt. Het hele argument is dat alles
 * gewoon te zien is, zonder offerte. Een bord met open panelen zegt dat, een
 * brochure zegt het niet.
 *
 * De kop heeft een eigen onderrand. Dat kleine detail is wat het als paneel
 * laat lezen in plaats van als een blok tekst met een rand eromheen.
 */

interface Props {
  /** Doorlopend nummer, staat linksboven in de kop. */
  nr?: string;
  /** Het label in de kop van de tegel. Kort houden, dit is vensterchroom.
   *  Bewust géén heading: de inhoud van de tegel heeft zijn eigen h2, en twee
   *  koppen met bijna dezelfde tekst is slecht voor een screenreader en voor
   *  de kopstructuur die Google uitleest. */
  titel?: string;
  /** Klein rechtsboven: een aantal, een prijs, een levertijd. */
  meta?: string;
  /** Hoeveel kolommen breed. 1 is de standaard, 3 is de volle breedte. */
  span?: 1 | 2 | 3;
  /** Twee rijen hoog, voor een tegel die anders te leeg staat. */
  hoog?: boolean;
  /** Vol mint. Eén keer per pagina, dat is het brandpunt. */
  accent?: boolean;
  /** Geen padding in de body, voor een tegel die zelf zijn randen bepaalt. */
  kaal?: boolean;
  id?: string;
  class?: string;
}

const {
  nr,
  titel,
  meta,
  span = 1,
  hoog = false,
  accent = false,
  kaal = false,
  id,
  class: klasse = '',
} = Astro.props;

/* md heeft maar twee kolommen, dus span 3 wordt daar 2. Pas vanaf xl telt de
   derde kolom mee. */
const breedte = {
  1: '',
  2: 'md:col-span-2',
  3: 'md:col-span-2 xl:col-span-3',
}[span];
---

<article
  id={id}
  class:list={[
    'kaart flex flex-col overflow-hidden rounded-vp border',
    accent ? 'border-mint bg-mint' : 'border-line bg-panel',
    breedte,
    hoog && 'md:row-span-2',
    klasse,
  ]}
>
  {
    (nr || titel || meta) && (
      <header
        class:list={[
          'flex items-baseline gap-3 border-b px-5 py-3.5 md:px-6',
          accent ? 'border-ink/25' : 'border-line',
        ]}
      >
        {nr && (
          <span class:list={['font-mono text-xs', accent ? 'op-mint-zacht' : 'text-mint-dim']}>
            {nr}
          </span>
        )}
        {titel && (
          <p
            class:list={[
              'flex-1 truncate text-sm font-semibold',
              accent ? 'op-mint' : 'text-fg',
            ]}
          >
            {titel}
          </p>
        )}
        {meta && (
          <span
            class:list={[
              'shrink-0 font-mono text-[0.6875rem]',
              accent ? 'op-mint-zacht' : 'text-faint',
            ]}
          >
            {meta}
          </span>
        )}
      </header>
    )
  }

  <!-- container-type maakt van deze body de meetlat voor kop-kaart, zodat een
       kop meeschaalt met de breedte van de tégel en niet met die van het
       venster. Zie de uitleg bij kop-kaart in global.css. -->
  <div class:list={['kaart-body flex-1', !kaal && 'p-5 md:p-7']}>
    <slot />
  </div>

  <style>
    .kaart-body {
      container-type: inline-size;
    }
  </style>
</article>
