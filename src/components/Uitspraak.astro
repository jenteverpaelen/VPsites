---
/**
 * Eén korte, luide band tussen twee lange stille.
 *
 * Dit is geen sectie met inhoud, het is een adempauze op formaat. De hele pagina
 * bestaat uit banden die je moet lezen; deze staat er om te landen. Dat is ook
 * wat het monotone ritme breekt waar de rest van de home aan leed.
 *
 * Beide bedragen zijn echt. €3.500 is de onderkant van de gangbare marktprijs
 * voor een site van vier tot vijf pagina's in België, met de bron in het
 * kennisartikel waar dit naar linkt. Het andere bedrag komt uit
 * src/data/prijzen.ts. Niets verzonnen, en dat is precies waarom het werkt.
 *
 * Eén keer per site, niet per pagina. Zet dit niet ook nog op /prijzen.
 */

import { starter } from '~/data/prijzen';
import Blok from '~/components/Blok.astro';
---

<Blok toon="diep">
  <p class="kop-uitspraak op-scroll mt-6 max-w-4xl font-semibold">
    Een bureau vraagt vanaf €1.500 voor vier pagina's.<br class="hidden md:block" />
    <span class="text-muted">Ik vraag </span><span class="text-mint">€{starter.prijs}</span
    ><span class="text-muted">.</span>
  </p>

  <p class="op-scroll mt-8 max-w-xl font-mono text-xs leading-relaxed text-faint">
    Zelfde aantal pagina's, zelfde werk. Het verschil zit in wie de rekening
    meebetaalt. <a
      href="/kennis/wat-kost-een-website-belgie"
      class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-mint hover:decoration-mint"
      >Hier staan de cijfers per type bureau</a
    >, en hieronder staat waarom ik eronder kan.
  </p>
</Blok>
