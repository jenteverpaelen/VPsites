---
import type { Pakket } from '~/data/prijzen';
import { introductie } from '~/data/prijzen';

interface Props {
  pakket: Pakket;
  /** Alleen op /prijzen staat er ook voor wie het pakket bedoeld is. */
  volledig?: boolean;
  /** Trap in de scroll-reveal, 0 tot 2, zodat de rij zich opbouwt in plaats
   *  van er in één keer te staan. */
  stap?: number;
}

const { pakket, volledig = false, stap = 0 } = Astro.props;

const toonIntro = introductie.actief && pakket.prijsNormaal !== null;

/* Altijd de volledige lijst. Er stond eerst "en nog 3 andere dingen" onder een
   afgekapte lijst, en dat is precies het soort halve informatie waar deze site
   tegen bedoeld is. Wie wil weten wat hij krijgt, moet het gewoon zien staan. */
const punten = pakket.bevat;
---

<!-- Geen uitgelicht pakket, geen "meest gekozen"-badge. Alle drie de kaarten
     zien er identiek uit. Wie welk pakket neemt, hangt af van wat hij nodig
     heeft, en niet van welke kaart ik een mint rand geef. -->
<article
  data-stap={String(stap)}
  class="op-scroll hover-lift relative flex flex-col rounded-vp border border-line bg-panel p-6 md:p-7"
>
  <header>
    <h3 class="text-xl font-semibold">{pakket.naam}</h3>
    <p class="mt-1.5 text-sm leading-snug text-muted">{pakket.regel}</p>
  </header>

  <div class="mt-6 flex items-baseline gap-3">
    <span class="flex items-baseline gap-2 text-5xl font-bold tracking-kop-groot tabular-nums">
      {pakket.vanaf && <span class="text-2xl font-normal text-faint">vanaf</span>}
      <span>&euro;{pakket.prijs}</span>
    </span>
    {
      toonIntro && (
        <span class="font-mono text-sm text-faint line-through decoration-faint/70">
          €{pakket.prijsNormaal}
        </span>
      )
    }
  </div>

  <p class="mt-2 font-mono text-xs text-mint">
    {toonIntro ? 'introductieprijs, alles inbegrepen' : 'alles inbegrepen, geen btw'}
  </p>

  <dl class="mt-6 grid grid-cols-2 gap-3 border-y border-line py-4 text-sm">
    <div>
      <dt class="label-mono">Klaar in</dt>
      <dd class="mt-1 text-fg">{pakket.levertijd}</dd>
    </div>
    <div>
      <dt class="label-mono">Omvang</dt>
      <dd class="mt-1 text-fg">{pakket.paginas}</dd>
    </div>
  </dl>

  {volledig && <p class="mt-5 text-sm leading-relaxed text-muted">{pakket.voor}</p>}

  <ul class="mt-5 flex-1 space-y-2.5 text-sm">
    {
      punten.map((punt) => (
        <li class="flex gap-2.5 leading-snug">
          <svg
            width="15"
            height="15"
            viewBox="0 0 15 15"
            fill="none"
            aria-hidden="true"
            class="mt-0.5 shrink-0 text-mint"
          >
            <path
              d="m3.4 7.8 2.6 2.6 5.6-5.8"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span class="text-muted">{punt}</span>
        </li>
      ))
    }
  </ul>

  <a
    href="/contact"
    class="mt-7 flex min-h-13 items-center justify-center rounded-vp border border-line bg-raise px-5 font-semibold text-fg transition-colors hover:border-mint/45 hover:bg-mint hover:text-ink"
  >
    Dit wil ik
    <span class="sr-only"> ({pakket.naam}, €{pakket.prijs})</span>
  </a>
</article>
