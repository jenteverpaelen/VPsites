---
import { existsSync, readFileSync } from 'node:fs';
import { bedrijf } from '~/data/bedrijf';

/**
 * Portret van Jente.
 *
 * Zodra public/jente.jpg bestaat, gebruikt dit component de varianten die
 * scripts/foto.mjs tijdens de build maakt. Geen bestand, geen probleem: dan
 * valt het terug op een typografisch portret. Bewust géén doos met "TODO"
 * erin, want als de site online gaat voor de foto er is, mag het er niet
 * stuk uitzien.
 *
 * Er is dus niets aan te passen in de code. Foto erin zetten volstaat.
 *
 * De breedtes staan hier niet hardgecodeerd. Het script schaalt nooit op, dus
 * welke varianten er zijn hangt af van hoe groot jouw foto is. Het schrijft ze
 * in meta.json en dit component leest dat. Zo bied ik nooit een srcset aan met
 * een bestand dat er niet is.
 */

type FotoMeta = {
  breedtes: number[];
  breedte: number;
  hoogte: number;
};

interface Props {
  class?: string;
  /** Alleen het eerste portret op een pagina is een LCP-kandidaat. */
  prioriteit?: boolean;
}

const { class: klasse = '', prioriteit = false } = Astro.props;

const metaPad = 'public/portret/meta.json';
const foto: FotoMeta | null = existsSync(metaPad)
  ? (JSON.parse(readFileSync(metaPad, 'utf8')) as FotoMeta)
  : null;

const sizes = '(min-width: 1024px) 28rem, (min-width: 640px) 24rem, 100vw';
const srcset = (extensie: string) =>
  (foto?.breedtes ?? []).map((b) => `/portret/jente-${b}.${extensie} ${b}w`).join(', ');

const initialen = 'JVP';
---

<div class:list={['relative aspect-4/5 overflow-hidden rounded-vp', klasse]}>
  {
    foto ? (
      <picture>
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
        <img
          src={`/portret/jente-${foto.breedte}.jpg`}
          alt={`${bedrijf.persoon}, de webdesigner achter ${bedrijf.naam}`}
          width={foto.breedte}
          height={foto.hoogte}
          loading={prioriteit ? 'eager' : 'lazy'}
          fetchpriority={prioriteit ? 'high' : 'auto'}
          decoding="async"
          class="h-full w-full object-cover"
        />
      </picture>
    ) : (
      <div class="portret flex h-full w-full flex-col justify-between border border-line bg-panel p-7">
        <span class="label-mono">{bedrijf.naam}</span>

        <span
          class="font-display text-[clamp(3.5rem,14vw,6rem)] leading-none font-bold tracking-kop-groot"
          aria-hidden="true"
        >
          {initialen}
        </span>

        <span class="font-mono text-xs leading-relaxed text-faint">
          {bedrijf.persoon}
          <br />
          {bedrijf.functie.toLowerCase()}
        </span>
      </div>
    )
  }
</div>

<style>
  .portret {
    background-image: radial-gradient(circle at center, var(--color-line) 1px, transparent 1px);
    background-size: 1.75rem 1.75rem;
    background-position: center;
  }
</style>
