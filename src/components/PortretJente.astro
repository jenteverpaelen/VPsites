---
import { bedrijf, telHref, mailHref } from '~/data/bedrijf';

/**
 * Geen foto, maar een gezet kaartje.
 *
 * Hier stond eerst een portretfoto. Jente wil zichzelf liever niet op de site,
 * en dan is een lege plek of een silhouet de slechtste oplossing van al. Dit is
 * de bewuste vervanging: een naamkaartje zoals een drukker het zou zetten.
 *
 * Waarom dit werkt op de plek van een portret: een foto doet één ding op deze
 * site, namelijk aantonen dat er een echt mens achter zit. Dat kan ook met een
 * echte naam, een echte gemeente en een echt nummer, en die staan hier alle drie.
 * Voor een lokale Vlaamse koper weegt een telefoonnummer dat je kan bellen even
 * zwaar als een gezicht.
 *
 * De verhouding blijft 4:5, dezelfde als de foto had, zodat de layouts eromheen
 * niet hoeven te wijzigen.
 */

interface Props {
  class?: string;
  /** Blijft bestaan zodat de aanroepen niet hoeven te wijzigen. Een kaartje
   *  hoeft niet vroeg geladen te worden, dus het doet hier verder niets. */
  prioriteit?: boolean;
}

const { class: klasse = '' } = Astro.props;

const initialen = bedrijf.persoon
  .split(' ')
  .map((deel) => deel[0])
  .join('');
---

<div
  class:list={[
    'kaartje relative flex aspect-4/5 flex-col justify-between overflow-hidden rounded-vp border border-line bg-panel p-7 md:p-8',
    klasse,
  ]}
>
  <!-- De initialen als watermerk. Groot, maar zo licht dat het textuur wordt in
       plaats van tekst. aria-hidden, want het is de naam die eronder al staat. -->
  <span class="kaartje-merk" aria-hidden="true">{initialen}</span>

  <div class="relative">
    <span class="block h-px w-10 bg-mint" aria-hidden="true"></span>
    <p class="mt-5 text-sm text-muted">{bedrijf.functie}</p>
  </div>

  <div class="relative">
    <p class="font-display text-[clamp(1.75rem,7cqw,2.5rem)] leading-tight">
      {bedrijf.persoon}
    </p>
    <p class="mt-2 text-sm text-muted">
      {bedrijf.adres.gemeente}, {bedrijf.regio}
    </p>
  </div>

  <dl class="relative space-y-1 text-sm">
    <div>
      <dt class="sr-only">Telefoon</dt>
      <dd>
        <a href={telHref} class="flex min-h-11 items-center transition-colors hover:text-mint">
          {bedrijf.telefoonWeergave}
        </a>
      </dd>
    </div>
    <div>
      <dt class="sr-only">E-mail</dt>
      <dd>
        <a
          href={mailHref}
          class="flex min-h-11 items-center break-all text-muted transition-colors hover:text-mint"
        >
          {bedrijf.email}
        </a>
      </dd>
    </div>
  </dl>
</div>

<style>
  .kaartje {
    /* container-type zodat de naam meeschaalt met de breedte van het kaartje en
       niet met die van het venster. Dit ding staat op /over in een kolom van
       28rem en op de home in een van 24rem. */
    container-type: inline-size;
  }

  /* cqw en geen rem: dit kaartje staat op /over in een kolom van 28rem en op de
     home in een van 24rem. Met een vaste maat liep het watermerk in de smalle
     versie middenin een letter tegen de rand, en dat leest als een fout in plaats
     van als een bewuste bleed. */
  .kaartje-merk {
    position: absolute;
    right: -0.04em;
    bottom: -0.16em;
    font-family: var(--font-display);
    font-size: 42cqw;
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.05em;
    color: var(--color-mint);
    opacity: 0.1;
    user-select: none;
  }
</style>
