---
/**
 * Leest de échte cijfers van de pagina die de bezoeker op dat moment bekijkt,
 * via PerformanceNavigationTiming en de Resource Timing API.
 *
 * Zelfreferentieel bewijs: de site beweert snel te zijn en toont meteen wat
 * ze zelf net gedaan heeft. Geen enkele lokale concurrent doet dit.
 *
 * De waarden staan al in de HTML met een streepje, zodat de breedte niet
 * verspringt wanneer JavaScript ze invult. Dat is CLS die we niet willen.
 */
---

<div
  class="mt-12 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-4 font-mono text-xs text-faint md:mt-16"
  data-perf
>
  <span class="text-mint-dim">deze pagina</span>

  <span>
    <span class="tabular-nums text-muted" data-perf-tijd>&ndash;&ndash;&ndash;</span> geladen
  </span>

  <span>
    <span class="tabular-nums text-muted" data-perf-gewicht>&ndash;&ndash;</span> overgehaald
  </span>

  <span>
    <span class="text-muted">0</span> cookies
  </span>

  <a
    href="https://pagespeed.web.dev/"
    target="_blank"
    rel="noopener"
    class="ml-auto inline-flex min-h-11 items-center gap-1 text-faint underline decoration-line underline-offset-4 transition-colors hover:text-mint hover:decoration-mint"
  >
    test het zelf
    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
      <path d="M3 8 8 3M8 3H4.2M8 3v3.8" stroke="currentColor" stroke-width="1.3"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</div>

<script>
  const strip = document.querySelector('[data-perf]');
  if (strip) {
    const toon = () => {
      const nav = performance.getEntriesByType('navigation')[0] as
        | PerformanceNavigationTiming
        | undefined;

      const veldTijd = strip.querySelector('[data-perf-tijd]');
      const veldGewicht = strip.querySelector('[data-perf-gewicht]');

      if (nav && veldTijd) {
        // Tot DOMContentLoaded. Dat is het moment waarop de pagina bruikbaar is.
        const ms = Math.max(0, nav.domContentLoadedEventEnd - nav.startTime);
        veldTijd.textContent = ms < 1000 ? `${Math.round(ms)}ms` : `${(ms / 1000).toFixed(2)}s`;
      }

      if (veldGewicht) {
        // transferSize is wat er effectief over de lijn ging, dus na compressie.
        // Bij een cache-hit is dat 0, en dan tonen we liever niets dan een leugen.
        const bronnen = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
        const bytes =
          (nav?.transferSize ?? 0) + bronnen.reduce((som, b) => som + (b.transferSize || 0), 0);

        veldGewicht.textContent = bytes > 0 ? `${Math.round(bytes / 1024)} KB` : 'uit cache';
      }
    };

    // Na load, zodat alle bronnen meegeteld zijn.
    if (document.readyState === 'complete') {
      requestAnimationFrame(toon);
    } else {
      window.addEventListener('load', () => requestAnimationFrame(toon), { once: true });
    }
  }
</script>
