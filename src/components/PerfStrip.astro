---
/**
 * Het meetpaneel in de hero. Leest de échte cijfers van de pagina die de
 * bezoeker op dat moment bekijkt, via PerformanceNavigationTiming en de
 * Resource Timing API.
 *
 * Zelfreferentieel bewijs: de site beweert snel te zijn en toont meteen wat
 * ze zelf net gedaan heeft, met de drempel van Google ernaast. Geen enkele
 * lokale concurrent doet dit.
 *
 * Alle waarden staan al in de HTML met een streepje op de plek waar het cijfer
 * komt, en elke rij heeft een vaste hoogte. Zo verspringt er niets wanneer
 * JavaScript ze invult. Dat zou CLS zijn en het doel is 0,00.
 */

const rijen = [
  { label: 'Overgehaald', sleutel: 'gewicht' },
  { label: 'JavaScript', sleutel: 'js' },
  { label: 'Verzoeken naar derden', sleutel: 'derden' },
  { label: 'Cookies', sleutel: 'cookies' },
];
---

<div
  class="meter rounded-vp border border-line bg-panel/70 p-5 backdrop-blur-sm md:p-6"
  data-perf
>
  <div class="flex items-center justify-between gap-3">
    <span class="flex items-center gap-2">
      <span class="stip-live" aria-hidden="true"></span>
      <span class="label-mono text-mint-dim">live gemeten</span>
    </span>
    <span class="font-mono text-[0.6875rem] text-faint">deze pagina</span>
  </div>

  <p class="mt-5 flex items-baseline gap-2">
    <!-- Middenpunten als plaatshouder. Leest als "nog aan het meten" en het is
         geen streepje, want die staan op de zwarte lijst. -->
    <span
      class="text-4xl font-bold tracking-kop-groot tabular-nums md:text-5xl"
      data-perf-tijd>·,·· s</span
    >
  </p>
  <p class="mt-1 text-sm text-muted">tot de pagina bruikbaar was</p>

  <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-raise">
    <div class="meter-balk h-full rounded-full bg-mint" data-perf-balk></div>
  </div>
  <p class="mt-2 font-mono text-[0.6875rem] text-faint">
    drempel van Google: 2,5 s
  </p>

  <dl class="mt-5 divide-y divide-line border-t border-line font-mono text-xs">
    {
      rijen.map((rij) => (
        <div class="flex h-10 items-center justify-between gap-4">
          <dt class="text-faint">{rij.label}</dt>
          <dd class="tabular-nums text-muted" data-perf-veld={rij.sleutel}>
            {rij.sleutel === 'cookies' || rij.sleutel === 'derden' ? '0' : '··'}
          </dd>
        </div>
      ))
    }
  </dl>

  <a
    href="https://pagespeed.web.dev/"
    target="_blank"
    rel="noopener"
    class="mt-4 inline-flex min-h-11 items-center gap-1.5 font-mono text-xs text-faint underline decoration-line underline-offset-4 transition-colors hover:text-mint hover:decoration-mint"
  >
    test het zelf op PageSpeed Insights
    <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
      <path d="M3 8 8 3M8 3H4.2M8 3v3.8" stroke="currentColor" stroke-width="1.3"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </a>
</div>

<style>
  .meter-balk {
    transform: scaleX(var(--vullen, 0));
    transform-origin: left;
    transition: transform 900ms 200ms var(--ease-uit);
  }

  @media (prefers-reduced-motion: reduce) {
    .meter-balk {
      transition: none;
    }
  }
</style>

<script>
  const paneel = document.querySelector<HTMLElement>('[data-perf]');

  if (paneel) {
    /** Twee cijfers achter de komma, en een komma, want dit is Nederlands. */
    const seconden = (ms: number) => `${(ms / 1000).toFixed(2).replace('.', ',')} s`;
    const kb = (bytes: number) =>
      bytes >= 10240 ? `${Math.round(bytes / 1024)} KB` : `${(bytes / 1024).toFixed(1).replace('.', ',')} KB`;

    const veld = (naam: string) => paneel.querySelector(`[data-perf-veld="${naam}"]`);

    const toon = () => {
      const nav = performance.getEntriesByType('navigation')[0] as
        | PerformanceNavigationTiming
        | undefined;
      const bronnen = performance.getEntriesByType('resource') as PerformanceResourceTiming[];

      // Tot DOMContentLoaded. Dat is het moment waarop de pagina bruikbaar is.
      const ms = nav ? Math.max(1, nav.domContentLoadedEventEnd - nav.startTime) : performance.now();

      const tijd = paneel.querySelector('[data-perf-tijd]');
      if (tijd) tijd.textContent = seconden(ms);

      // De balk staat vol op de drempel van Google, niet op de eigen tijd.
      // Anders zie je nooit hoe veel ruimte er nog over is.
      paneel.style.setProperty('--vullen', String(Math.min(1, ms / 2500)));

      // transferSize is wat er effectief over de lijn ging, dus na compressie.
      // Bij een cache-hit is dat 0, en dan tonen we liever niets dan een leugen.
      const bytes =
        (nav?.transferSize ?? 0) + bronnen.reduce((som, b) => som + (b.transferSize || 0), 0);
      const jsBytes = bronnen
        .filter((b) => b.initiatorType === 'script' || b.name.endsWith('.js'))
        .reduce((som, b) => som + (b.transferSize || 0), 0);

      const gewicht = veld('gewicht');
      if (gewicht) gewicht.textContent = bytes > 0 ? kb(bytes) : 'uit cache';

      const js = veld('js');
      if (js) js.textContent = bytes > 0 ? kb(jsBytes) : 'uit cache';

      // Alles van een ander domein. Hier hoort 0 te staan en dat is het punt.
      const derden = bronnen.filter((b) => {
        try {
          return new URL(b.name, location.href).origin !== location.origin;
        } catch {
          return false;
        }
      }).length;

      const veldDerden = veld('derden');
      if (veldDerden) veldDerden.textContent = String(derden);

      const veldCookies = veld('cookies');
      if (veldCookies) {
        veldCookies.textContent = String(document.cookie ? document.cookie.split(';').length : 0);
      }
    };

    // Na load, zodat alle bronnen meegeteld zijn.
    if (document.readyState === 'complete') {
      requestAnimationFrame(toon);
    } else {
      window.addEventListener('load', () => requestAnimationFrame(toon), { once: true });
    }
  }
</script>
