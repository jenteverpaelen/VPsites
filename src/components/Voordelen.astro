---
/**
 * Wat een goede site je oplevert, in drie voordelen die elkaar afwisselen.
 *
 * Stond hier eerst: een paneel met de live gemeten laadtijd van deze pagina.
 * Technisch mooi, maar het antwoordde op een vraag die de bezoeker niet stelt.
 * Een schrijnwerker wil niet weten hoeveel milliseconden de pagina nodig had, hij
 * wil weten wat het hem opbrengt. Dat meetpaneel staat nu bij de sectie over
 * snelheid, waar het wel hoort.
 *
 * Geen verzonnen cijfers. Er bestaat geen betrouwbaar percentage voor "een
 * website levert x procent meer klanten op", dus staat er hier geen. Wat er staat
 * is wat er echt gebeurt als iemand je opzoekt.
 *
 * De wisseling is pure CSS met drie keyframes en een vertraging per item. Nul
 * JavaScript. Onder prefers-reduced-motion staan alle drie stil onder elkaar, dus
 * niemand mist inhoud.
 */

const voordelen = [
  {
    kop: 'Meer klanten',
    tekst:
      'Mensen zoeken je op voor ze bellen. Wie niets vindt, belt gewoon de volgende in de lijst.',
  },
  {
    kop: 'Meer bereik',
    tekst:
      'Gevonden worden op je stiel én je gemeente, ook door mensen die je naam nog nooit gehoord hebben.',
  },
  {
    kop: 'Meer vertrouwen',
    tekst:
      'Een site die er deftig uitziet doet de helft van het verkopen al voor je, nog voor je opneemt.',
  },
];
---

<div class="voordelen rounded-vp border border-line bg-panel p-7 md:p-8">
  <p class="flex items-center gap-3 text-sm text-mint">
    <span class="h-px w-8 bg-mint/40" aria-hidden="true"></span>
    Wat het je opbrengt
  </p>

  <!-- Vaste hoogte, want de drie items liggen over elkaar. Zonder die hoogte
       klapt het vak dicht en dat is layout shift. -->
  <div class="voordelen-vak mt-6">
    {
      voordelen.map((voordeel, i) => (
        <div class="voordeel" style={`--i: ${i}`}>
          <p class="text-2xl leading-tight md:text-3xl">{voordeel.kop}</p>
          <p class="mt-3 leading-relaxed text-muted">{voordeel.tekst}</p>
        </div>
      ))
    }
  </div>

  <ul class="voordelen-stippen mt-6 flex gap-2" aria-hidden="true">
    {voordelen.map((_, i) => <li class="stip" style={`--i: ${i}`} />)}
  </ul>
</div>

<style>
  .voordelen-vak {
    position: relative;
    min-height: 8.5rem;
  }

  .voordeel {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* 3 items van 4,5s, dus een ronde van 13,5s. Elk item start 4,5s later. */
    animation: voordeel-wissel 13.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 4.5s);
  }

  /* Zichtbaar van 0 tot een derde, met een korte fade aan beide kanten. */
  @keyframes voordeel-wissel {
    0%,
    2% {
      opacity: 0;
      transform: translate3d(0, 0.5rem, 0);
    }
    6%,
    28% {
      opacity: 1;
      transform: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: translate3d(0, -0.5rem, 0);
    }
  }

  .stip {
    width: 1.5rem;
    height: 2px;
    background-color: var(--color-line);
    position: relative;
    overflow: hidden;
  }

  .stip::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-mint);
    transform: scaleX(0);
    transform-origin: left;
    animation: stip-vullen 13.5s linear infinite;
    animation-delay: calc(var(--i) * 4.5s);
  }

  @keyframes stip-vullen {
    0% {
      transform: scaleX(0);
    }
    33% {
      transform: scaleX(1);
    }
    34%,
    100% {
      transform: scaleX(0);
    }
  }

  /* Alles stil, en dan moeten de drie wél alle drie leesbaar zijn. Dus uit de
     stapel halen en onder elkaar zetten. */
  @media (prefers-reduced-motion: reduce) {
    .voordelen-vak {
      min-height: 0;
      display: grid;
      gap: 1.75rem;
    }

    .voordeel {
      position: static;
      inset: auto;
      opacity: 1;
      transform: none;
      animation: none;
    }

    .voordelen-stippen {
      display: none;
    }
  }
</style>
