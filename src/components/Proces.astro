---
/**
 * Het proces als build-pipeline. De mint lijn loopt mee op scroll via
 * animation-timeline: scroll(). Nul JavaScript.
 *
 * De lijn schaalt met transform, niet met height, want height herberekent
 * de layout. Zie CLAUDE.md deel 7 over de Visual Stability Index.
 */

const stappen = [
  {
    tag: 'intake',
    kop: 'We bellen of ik kom langs',
    duur: '30 min',
    tekst:
      'Je vertelt wat je doet en voor wie. Ik zeg je meteen welk pakket past en wat het kost. Geen offerte die drie dagen later per mail komt.',
  },
  {
    tag: 'ontwerp',
    kop: 'Je ziet het voor ik bouw',
    duur: '2 tot 4 dagen',
    tekst:
      'Ik maak een ontwerp van de homepagina en stuur het door. Bevalt het niet, dan passen we aan. Je betaalt niets tot je hier ja op zegt.',
  },
  {
    tag: 'bouw',
    kop: 'Ik bouw, jij kijkt mee',
    duur: '3 tot 8 dagen',
    tekst:
      'Je krijgt een link waarop je live ziet hoe het vordert. Twee rondes aanpassingen zitten erbij, ruim genoeg om het juist te krijgen.',
  },
  {
    tag: 'live',
    kop: 'Online, en dan ben je van mij af',
    duur: '1 dag',
    tekst:
      'Domeinnaam gekoppeld, site online, Google op de hoogte. Ik zet je Google Bedrijfsprofiel mee in orde. Daarna heb je niets meer nodig, en dat is de bedoeling.',
  },
];
---

<section class="sectie border-t border-line">
  <div class="container-vp">
    <p class="comment-mono op-scroll"><span class="text-mint-dim">//</span> van bellen tot online</p>

    <div class="mt-5 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <h2 class="op-scroll max-w-2xl text-3xl sm:text-4xl md:text-5xl">Hoe het loopt</h2>
      <p class="op-scroll font-mono text-sm text-faint">totaal: 1 tot 2 weken</p>
    </div>

    <ol class="pijplijn relative mt-16">
      <!-- Het spoor loopt achter de stappen door. -->
      <span class="pijplijn-spoor" aria-hidden="true"></span>
      <span class="pijplijn-lijn" aria-hidden="true"></span>

      {
        stappen.map((stap, i) => (
          <li class="op-scroll relative grid gap-x-8 gap-y-3 pb-12 pl-14 last:pb-0 md:grid-cols-12 md:pl-20">
            <span class="pijplijn-punt" aria-hidden="true">
              <span class="pijplijn-ring"></span>
              {String(i + 1).padStart(2, '0')}
            </span>

            <div class="md:col-span-4">
              <span class="label-mono text-mint-dim">{stap.tag}</span>
              <h3 class="mt-2 text-xl leading-snug">{stap.kop}</h3>
              <p class="mt-1.5 font-mono text-xs text-faint">{stap.duur}</p>
            </div>

            <p class="leading-relaxed text-muted md:col-span-8 md:pt-7">{stap.tekst}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .pijplijn-spoor,
  .pijplijn-lijn {
    position: absolute;
    left: 1rem;
    top: 0.25rem;
    bottom: 1.5rem;
    width: 3px;
    border-radius: 2px;
  }

  @media (width >= 48rem) {
    .pijplijn-spoor,
    .pijplijn-lijn {
      left: 1.375rem;
    }
  }

  .pijplijn-spoor {
    background-color: var(--color-line);
  }

  .pijplijn-lijn {
    background-color: var(--color-mint);
    transform: scaleY(0);
    transform-origin: top;
    /* Kopje mint licht aan de voorkant, zodat je ziet waar de lijn zit. */
    box-shadow: 0 0 12px 1px color-mix(in srgb, var(--color-mint) 45%, transparent);
  }

  /* Loopt mee terwijl je door de sectie scrollt.

     Het bereik stond op `entry 55% cover 72%`. Dat is een geldig bereik, maar de
     lengte ervan hangt af van de hoogte van het scherm: op een hoge desktop was
     de lijn al bijna vol terwijl je nog aan stap twee las, op een smal scherm
     kroop hij mee. Vandaar dat het in de ene browser wel opvalt en in de andere
     niet.

     `entry 50% exit 50%` is precies één schermhoogte scrollen, wat het scherm
     ook is. De lijn is dus leeg als de sectie halfweg binnenkomt en vol als ze
     halfweg vertrekt. Dat is voorspelbaar en het valt op.

     Longhands en duration: auto, zie de uitleg in global.css. */
  @supports (animation-timeline: view()) {
    .pijplijn-lijn {
      animation-name: lijn-groeien;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: entry 50% exit 50%;
    }
  }

  @supports not (animation-timeline: view()) {
    .pijplijn-lijn {
      transform: scaleY(1);
      opacity: 0.35;
    }
  }

  @keyframes lijn-groeien {
    to {
      transform: scaleY(1);
    }
  }

  .pijplijn-punt {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-line);
    background-color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-faint);
  }

  @media (width >= 48rem) {
    .pijplijn-punt {
      width: 3rem;
      height: 3rem;
      font-size: 0.75rem;
    }
  }

  /* De ring licht op wanneer de stap in beeld komt. Enkel opacity, want een
     border-color animeren mag niet volgens de regel in CLAUDE.md deel 7. */
  .pijplijn-ring {
    position: absolute;
    inset: -1px;
    border-radius: 999px;
    border: 1px solid var(--color-mint);
    opacity: 0;
  }

  /* Het bereik staat op cover en niet op entry, want de subject is hier de ring
     zelf en die is maar 34 pixels hoog. Een entry-bereik is dan ook 34 pixels
     scrollen en dan ploft de ring aan in plaats van op te komen. */
  @supports (animation-timeline: view()) {
    .pijplijn-ring {
      animation-name: ring-aan;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: view();
      animation-range: cover 10% cover 35%;
    }
  }

  @keyframes ring-aan {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pijplijn-lijn {
      animation: none !important;
      transform: scaleY(1);
      opacity: 0.35;
      box-shadow: none;
    }
    .pijplijn-ring {
      animation: none !important;
      opacity: 0.5;
    }
  }
</style>
