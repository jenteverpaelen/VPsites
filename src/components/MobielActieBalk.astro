---
import { bedrijf, telHref } from '~/data/bedrijf';

/**
 * Vaste balk onderaan op mobiel, in de duimzone.
 * Voor een lokale dienstverlener is dit het element met de grootste impact
 * op mobiele conversie: bellen mag nooit meer dan één tik ver zijn.
 *
 * Verschijnt terwijl je door de hero scrollt, via een scroll-gedreven
 * CSS-animatie. Nul JavaScript. Alleen opacity en transform, dus geen
 * layout-herberekening. Zie CLAUDE.md deel 7 over de Visual Stability Index.
 */
---

<div class="actiebalk md:hidden" aria-label="Snel contact">
  <div class="flex gap-2 px-4 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3">
    <a
      href={telHref}
      class="flex min-h-13 flex-1 items-center justify-center gap-2 rounded-vp bg-mint font-semibold text-ink"
    >
      <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
        <path
          d="M5.6 2.5 7 5.4 5.5 7c.8 1.7 2.1 3 3.8 3.8l1.6-1.5 2.9 1.4v2.6c0 .7-.6 1.3-1.3 1.2C7.3 14.1 2.9 9.7 2.4 4.1c-.1-.7.5-1.3 1.2-1.3z"
          fill="currentColor"></path>
      </svg>
      Bellen
    </a>
    <a
      href="/contact"
      class="flex min-h-13 flex-1 items-center justify-center gap-2 rounded-vp border border-line bg-raise font-medium text-fg"
    >
      <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
        <rect x="2.2" y="3.8" width="12.6" height="9.4" rx="1.6" stroke="currentColor" stroke-width="1.4"
        ></rect>
        <path d="m2.8 4.8 5.7 4 5.7-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"
        ></path>
      </svg>
      Mailen
    </a>
  </div>
  <span class="sr-only">Bel {bedrijf.telefoonWeergave} of ga naar de contactpagina.</span>
</div>

<style>
  .actiebalk {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    border-top: 1px solid var(--color-line);
    background-color: color-mix(in srgb, var(--color-ink) 92%, transparent);
    backdrop-filter: blur(12px);
  }

  @keyframes balk-in {
    from {
      opacity: 0;
      transform: translate3d(0, 100%, 0);
      pointer-events: none;
    }
    to {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }

  /* Komt tevoorschijn terwijl je door de hero scrollt. */
  @supports (animation-timeline: scroll()) {
    .actiebalk {
      animation: balk-in linear both;
      animation-timeline: scroll(root block);
      animation-range: 0 55vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .actiebalk {
      animation: none !important;
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
  }
</style>

<style is:global>
  /* Zodat de balk de laatste regels van de footer niet afdekt. */
  @media (width < 48rem) {
    body:has(.actiebalk) footer {
      padding-bottom: 5.5rem;
    }
  }
</style>
