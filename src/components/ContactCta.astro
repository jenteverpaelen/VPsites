---
import { bedrijf, telHref, mailHref } from '~/data/bedrijf';
import { goedkoopstePrijs } from '~/data/prijzen';
import Kaart from '~/components/Kaart.astro';

/**
 * Het enige volle mint vlak op de pagina.
 *
 * Hiervoor was dit een donkere band met een mint knopje erin, net als elke
 * andere band erboven. Daardoor had de pagina nergens een brandpunt en las mint
 * als een kleur die de site niet durfde te gebruiken. Nu is het laatste dat je
 * ziet ook het enige dat schreeuwt.
 *
 * Eén vol vlak per pagina, want twee brandpunten is nul brandpunten. Zie de
 * één-accent-regel in CLAUDE.md deel 3.
 *
 * Tekst is hier ink en niet fg, via op-mint en op-mint-zacht. De knoppen keren
 * mee om: de primaire wordt het donkere vlak, want op mint is donker het
 * accent.
 */
---

<!-- Op md twee kolommen breed, op xl één. Zo staat het mint vlak op een breed
     scherm naast de vragen en anker het de hoek van het bord, terwijl het op een
     tablet een volle rij pakt in plaats van een halve met een gat ernaast. -->
<Kaart nr="12" titel="Contact" accent class="md:col-span-2 xl:col-span-1">
  <div>
      <!-- Hier bewust niet comment-mono, want die utility zet zelf color op
           faint. Twee utilities die dezelfde property zetten worden door
           Tailwind gesorteerd en niet door de volgorde in het class-attribuut,
           dus welke wint is niet te zien aan deze regel. Faint op mint haalt
           1,9:1. Dus liever de opmaak hier uitgeschreven. -->
      <p class="op-scroll op-mint-zacht font-mono text-[0.8125rem] tracking-[0.01em]">
        <span aria-hidden="true">//</span> geen formulier van twintig velden
      </p>

      <h2 class="kop-kaart op-scroll op-mint mt-5">Stuur me gewoon wat je doet.</h2>

      <p class="op-scroll op-mint-zacht mt-7 max-w-xl text-lg leading-relaxed md:text-xl">
        Eén zin volstaat. Ik antwoord binnen de dag met wat het bij jou zou kosten en
        hoelang het duurt. Kost je niets en je zit nergens aan vast.
      </p>

      <div class="op-scroll mt-10 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact"
          class="group inline-flex min-h-13 items-center justify-center gap-2 rounded-vp bg-ink px-6 font-semibold text-fg transition-transform hover:-translate-y-0.5"
        >
          Vraag een prijs
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
            class="transition-transform group-hover:translate-x-0.5">
            <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <!-- border-ink/60 en niet /25: op mint haalt 25 procent maar 1,7:1 en de
             rand van een knop moet 3:1 halen. Op 60 procent is het 4,5 in het
             donker en 3,3 in het licht. -->
        <a
          href={telHref}
          class="op-mint inline-flex min-h-13 items-center justify-center rounded-vp border border-ink/60 px-6 font-medium transition-colors hover:bg-ink/10"
        >
          Of bel {bedrijf.telefoonWeergave}
        </a>
      </div>

      <p class="op-scroll op-mint-zacht mt-6 flex flex-wrap items-center gap-x-2 font-mono text-xs">
        <span>Vanaf &euro;{goedkoopstePrijs} en dat is de eindprijs.</span>
        <a
          href={mailHref}
          class="op-mint inline-flex min-h-11 items-center underline decoration-ink/40 underline-offset-4 hover:decoration-ink"
        >
          {bedrijf.email}
        </a>
      </p>
  </div>
</Kaart>
