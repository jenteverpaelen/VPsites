---
import { bedrijf, telHref, mailHref } from '~/data/bedrijf';
import { pakketten } from '~/data/prijzen';

const goedkoopste = Math.min(...pakketten.map((p) => p.prijs));
---

<section class="relative overflow-hidden border-t border-line">
  <div class="cta-gloed" aria-hidden="true"></div>

  <div class="container-vp relative py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="comment-mono op-scroll"><span class="text-mint-dim">//</span> geen formulier van twintig velden</p>

      <h2 class="op-scroll mt-5 text-3xl sm:text-4xl md:text-5xl">
        Stuur me gewoon wat je doet.
      </h2>

      <p class="op-scroll mt-6 text-lg leading-relaxed text-muted">
        Eén zin volstaat. Ik antwoord binnen de dag met wat het bij jou zou kosten en
        hoelang het duurt. Kost je niets en je zit nergens aan vast.
      </p>

      <div class="op-scroll mt-9 flex flex-col gap-3 sm:flex-row">
        <a
          href="/contact"
          class="group inline-flex min-h-13 items-center justify-center gap-2 rounded-vp bg-mint px-6 font-semibold text-ink transition-colors hover:bg-mint-dim"
        >
          Vraag een prijs
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
            class="transition-transform group-hover:translate-x-0.5">
            <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a
          href={telHref}
          class="inline-flex min-h-13 items-center justify-center rounded-vp border border-line bg-panel px-6 font-medium transition-colors hover:border-line-soft hover:bg-raise"
        >
          Of bel {bedrijf.telefoonWeergave}
        </a>
      </div>

      <p class="op-scroll mt-4 flex flex-wrap items-center gap-x-2 font-mono text-xs text-faint">
        <span>Vanaf €{goedkoopste} en dat is de eindprijs.</span>
        <a
          href={mailHref}
          class="inline-flex min-h-11 items-center underline decoration-line underline-offset-4 hover:text-mint"
        >
          {bedrijf.email}
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-gloed {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      44rem 22rem at 12% 120%,
      color-mix(in srgb, var(--color-mint) 9%, transparent),
      transparent 70%
    );
  }
</style>
