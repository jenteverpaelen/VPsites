---
import { bedrijf, telHref, mailHref, whatsappHref } from '~/data/bedrijf';
import { goedkoopstePrijs } from '~/data/prijzen';

/**
 * Het enige volle mint vlak op de pagina.
 *
 * Hiervoor was dit een donkere band met een mint knopje erin, net als elke
 * andere band erboven. Daardoor had de pagina nergens een brandpunt en las mint
 * als een kleur die de site niet durfde te gebruiken. Nu is het laatste dat je
 * ziet ook het enige dat schreeuwt.
 *
 * Eén vol vlak per pagina, want twee brandpunten is nul brandpunten. Zie de
 * één-accent-regel in CLAUDE.md deel 3.
 *
 * Tekst is hier ink en niet fg, via op-mint en op-mint-zacht. De knoppen keren
 * mee om: de primaire wordt het donkere vlak, want op mint is donker het
 * accent.
 */
---

<!-- Eén vol klei-vlak over de volle breedte, gecentreerd. Het laatste wat je
     ziet en het enige dat luid is. Geen tegel meer op een bord: dit is een band
     die de pagina afsluit, en dat is wat een editorial pagina doet.

     Tekst is hier papier op klei, via op-mint en op-mint-zacht. De primaire knop
     keert mee om en wordt het donkere vlak. -->
<section class="sectie-ruim bg-mint">
  <div class="container-vp text-center">
      <p class="op-scroll op-mint-zacht flex items-center justify-center gap-3 text-sm">
        <span class="h-px w-8 bg-ink/30" aria-hidden="true"></span>
        Contact
      </p>

      <h2 class="kop-kaart op-scroll op-mint mx-auto mt-6 max-w-3xl">
        Stuur me gewoon wat je doet.
      </h2>

      <p class="op-scroll op-mint-zacht mx-auto mt-7 max-w-xl text-lg leading-relaxed md:text-xl">
        Eén zin volstaat. Ik antwoord binnen de dag met wat het bij jou zou kosten en
        hoelang het duurt. Kost je niets en je zit nergens aan vast.
      </p>

      <div class="op-scroll mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/contact"
          class="group inline-flex min-h-13 items-center justify-center gap-2 rounded-vp bg-ink px-7 font-semibold text-fg transition-transform hover:-translate-y-0.5"
        >
          Vraag een prijs
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
            class="transition-transform group-hover:translate-x-0.5">
            <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
              stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>

        <!-- border-ink/55 en niet /25: op klei haalt 25 procent maar 1,7:1 en de
             rand van een knop moet 3:1 halen. -->
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="op-mint inline-flex min-h-13 items-center justify-center gap-2.5 rounded-vp border border-ink/55 px-6 font-medium transition-colors hover:bg-ink/10"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.97L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.16 0-.43.06-.65.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.72 2.63 4.17 3.69.58.25 1.04.4 1.4.51.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.14-1.18-.06-.11-.22-.17-.47-.29Z"
            />
          </svg>
          WhatsApp
        </a>

        <a
          href={telHref}
          class="op-mint inline-flex min-h-13 items-center justify-center rounded-vp border border-ink/55 px-6 font-medium transition-colors hover:bg-ink/10"
        >
          Bel {bedrijf.telefoonWeergave}
        </a>
      </div>

      <p class="op-scroll op-mint-zacht mt-7 flex flex-wrap items-center justify-center gap-x-2 text-sm">
        <span>Vanaf &euro;{goedkoopstePrijs} en dat is de eindprijs.</span>
        <a
          href={mailHref}
          class="op-mint inline-flex min-h-11 items-center underline decoration-ink/40 underline-offset-4 hover:decoration-ink"
        >
          {bedrijf.email}
        </a>
      </p>
  </div>
</section>
