---
/**
 * Eerste sectie na de hero, en die gaat bewust niet over Jente.
 * Uit het onderzoek: 52% van de zelfstandigen ziet de meerwaarde van een
 * website niet en 70% denkt het zonder te kunnen. Dus eerst het nut,
 * pas daarna het aanbod.
 */

const gevallen = [
  {
    kop: 'Je hebt geen website',
    tekst:
      'Mensen googelen je naam, vinden een Facebookpagina van 2019 en bellen de volgende in de lijst. Je weet niet hoeveel werk je daardoor misloopt, want die telefoon gaat gewoon niet.',
  },
  {
    kop: 'Je hebt er een die je niet meer durft tonen',
    tekst:
      'Gemaakt door een neef, een sjabloon van tien jaar geleden, of iets dat op een gsm niet te lezen valt. Je stuurt klanten liever een foto via WhatsApp dan een link.',
  },
  {
    kop: 'Je begon er zelf aan',
    tekst:
      'Drie avonden in een bouwer gestoken, vastgelopen op je domeinnaam, en sindsdien staat het op een half afgewerkte pagina. Dat kost je maandelijks geld en het staat er nog altijd.',
  },
];
---

<section class="sectie border-t border-line">
  <div class="container-vp">
    <p class="comment-mono op-scroll"><span class="text-mint-dim">//</span> waar het meestal misloopt</p>

    <h2 class="op-scroll mt-5 max-w-3xl kop-sectie">
      Je klant zoekt je op zijn gsm.<br class="hidden sm:block" />
      <span class="text-muted">Wat vindt hij?</span>
    </h2>

    <div class="mt-14 grid gap-px overflow-hidden rounded-vp border border-line bg-line md:grid-cols-3">
      {
        gevallen.map((geval, i) => (
          <article class="op-scroll flex flex-col bg-panel p-7 md:p-8">
            <span class="font-mono text-xs text-mint-dim">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-4 text-xl leading-snug">{geval.kop}</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{geval.tekst}</p>
          </article>
        ))
      }
    </div>

    <p class="op-scroll mt-10 max-w-2xl text-lg leading-relaxed text-muted">
      Alle drie kosten ze je hetzelfde: klanten die bij iemand anders terechtkomen omdat
      die er professioneler uitzag. <span class="text-fg">Daar is geen 4.000 euro voor nodig.</span>
    </p>
  </div>
</section>
