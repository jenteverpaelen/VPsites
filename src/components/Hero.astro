---
import Voordelen from '~/components/Voordelen.astro';
import { goedkoopstePrijs, introductie, levertijdKort } from '~/data/prijzen';

const vrij = introductie.actief && introductie.plaatsenOver > 0;
---

<!-- Geen tegel meer met een rand eromheen: de hero is de volle breedte van de
     pagina, met ruime witruimte in plaats van een kader. Dat is wat het van een
     dashboard naar een tijdschrift brengt. -->
<section class="hero relative overflow-hidden">
  <!-- Drie lagen achtergrond. Het raster drijft heel traag, de aura ademt, en
       de gloed volgt de muis. Alleen transform en opacity, dus geen enkele
       herberekening van de layout. De twee lussen staan achter pointer: fine,
       want een animatie die eeuwig doorloopt kost batterij op een gsm. -->
  <div class="hero-raster" aria-hidden="true"></div>
  <div class="hero-aura" aria-hidden="true"></div>
  <div class="hero-aura-2" aria-hidden="true"></div>
  <div class="hero-gloed" aria-hidden="true"></div>

  <div class="container-vp relative pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        {
          vrij && (
            <p class="hero-in inline-flex min-h-9 items-center gap-2.5 rounded-full border border-mint/30 bg-mint-deep px-4 text-sm text-mint">
              <span class="stip-live" aria-hidden="true" />
              Nog {introductie.plaatsenOver} plaatsen aan introductieprijs
            </p>
          )
        }

        <!-- Was een `// commentaar` in mono. Dat was het developer-signaal, en
             precies dat moest eraf: mono maakt van een zin een terminalregel. -->
        <p class="hero-in mt-5 text-sm text-muted" style="--in: 1">
          Vaste prijs <span class="text-faint">·</span> {levertijdKort}
          <span class="text-faint">·</span> geen abonnement
        </p>

        <!-- Regel per regel omhoog, alsof de zetter de tekst in het kader
             schuift. Elke regel is een eigen blok met een clip-path eromheen.

             clip-path en niet overflow of opacity, om twee redenen. Een clip
             raakt de layout niet, dus er herloopt geen tekst en er is geen CLS.
             En hij verft wel, in tegenstelling tot opacity 0: een element dat
             volledig doorzichtig is telt niet als geverfd en dat stelt de
             LCP-meting uit. Deze kop is het LCP-element van de pagina. -->
        <h1 class="kop-hero-tegel mt-5">
          <span class="kop-regel" style="--r: 0">Een site die laadt</span>
          <span class="kop-regel" style="--r: 1">
            <span class="relative inline-block">
              vóór je ademt.
              <span class="hero-streep" aria-hidden="true"></span>
            </span>
          </span>
        </h1>

        <p class="hero-in mt-7 max-w-xl text-lg leading-relaxed text-muted md:text-xl" style="--in: 2">
          Voor zelfstandigen die geen 4.000 euro willen betalen voor vier pagina's.
          Vanaf <span class="font-semibold text-fg">€{goedkoopstePrijs}</span>, en dat is
          meteen de eindprijs. <span class="text-fg">Geen btw.</span>
        </p>

        <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--in: 3">
          <a
            href="/prijzen"
            class="group inline-flex min-h-13 items-center justify-center gap-2 rounded-vp bg-mint px-6 font-semibold text-ink transition-colors hover:bg-mint-dim"
          >
            Bekijk wat het kost
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
              class="transition-transform group-hover:translate-x-0.5">
              <path d="M3 8h9m0 0L8.5 4.5M12 8l-3.5 3.5" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="/werk"
            class="inline-flex min-h-13 items-center justify-center rounded-vp border border-line bg-panel px-6 font-medium text-fg transition-colors hover:border-line-soft hover:bg-raise"
          >
            Bekijk mijn werk
          </a>
        </div>
      </div>

      <div class="hero-in lg:col-span-5" style="--in: 4">
        <Voordelen />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Geen 100vh: op mobiel springt vh mee met de browserbalk. En een hero
       die precies het scherm vult verbergt dat er nog iets onder staat. */
    background:
      radial-gradient(
        60rem 40rem at 15% -10%,
        color-mix(in srgb, var(--color-mint) 6%, transparent),
        transparent 70%
      );
  }

  /* Eén regel voor beide weergaven: de stippen worden uit fg gemengd, en fg
     draait mee met het thema. Hiervoor stond hier een aparte override omdat de
     line-token op bijna wit onzichtbaar is. Die is nu niet meer nodig. */
  .hero-raster {
    position: absolute;
    /* Ruimer dan de sectie, zodat het driften nergens een rand laat zien. */
    inset: -4rem -6rem;
    background-image: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--color-fg) 13%, transparent) 1px,
      transparent 1px
    );
    background-size: 2.25rem 2.25rem;
    /* Naar de randen toe uitfaden, anders wordt het een tafelkleed. */
    mask-image: radial-gradient(54rem 34rem at 22% 0%, #000 0%, transparent 78%);
  }

  .hero-aura,
  .hero-aura-2,
  .hero-gloed {
    display: none;
  }

  @media (pointer: fine) {
    /* Eén raster-tegel per 34 seconden. Je ziet het niet bewegen, je merkt
       alleen dat het beeld niet dood staat. */
    .hero-raster {
      animation: raster-drift 34s linear infinite;
    }

    /* Twee zwervende gloedvlekken in plaats van één die alleen ademde.

       De trucs die het organisch maken: de twee zijn verschillend groot en
       verschillend sterk, ze zwerven over een ander traject, en hun rondes duren
       11 en 17 seconden. Omdat die twee priemgetallen zijn, staan ze pas na drie
       minuten weer samen in dezelfde stand. Je herkent dus nooit een lus.

       De rondes stonden eerst op 34 en 47 seconden. Nagemeten: dat is ongeveer 6
       pixels per seconde en dan bewéégt het wel, maar zie je het niet. Nu zit het
       rond 70 pixels per seconde, en dat is wat je ook echt ziet gebeuren.

       Alleen transform, dus dit loopt op de compositor en kost geen herberekening
       van de layout. will-change houdt de twee lagen op de GPU, wat bij een
       animatie die altijd doorloopt precies is wat je wil. */
    .hero-aura,
    .hero-aura-2 {
      display: block;
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      will-change: transform;
    }

    .hero-aura {
      top: -20rem;
      right: -14rem;
      width: 48rem;
      height: 48rem;
      background: radial-gradient(
        closest-side,
        color-mix(in srgb, var(--color-mint) 11%, transparent),
        transparent 70%
      );
      animation: aura-zwerven-a 11s ease-in-out infinite;
    }

    .hero-aura-2 {
      bottom: -26rem;
      left: -12rem;
      width: 42rem;
      height: 42rem;
      background: radial-gradient(
        closest-side,
        color-mix(in srgb, var(--color-mint) 8%, transparent),
        transparent 72%
      );
      animation: aura-zwerven-b 17s ease-in-out infinite;
    }

    .hero-gloed {
      display: block;
      position: absolute;
      inset: 0;
      background: radial-gradient(
        14rem 14rem at var(--muis-x, -100%) var(--muis-y, -100%),
        color-mix(in srgb, var(--color-mint) 13%, transparent),
        transparent 65%
      );
      opacity: 0;
      transition: opacity 400ms var(--ease-uit);
    }

    .hero:hover .hero-gloed {
      opacity: 1;
    }
  }

  @keyframes raster-drift {
    to {
      transform: translate3d(-2.25rem, -2.25rem, 0);
    }
  }

  /* De twee zwerftrajecten.

     Ze eindigen waar ze beginnen, anders springt de vlek terug bij elke ronde.
     De tussenstops staan niet op gelijke afstanden en de twee trajecten lopen
     niet dezelfde kant op, want dat is wat het onvoorspelbaar maakt. Alleen
     translate en scale, dus dit blijft op de compositor. */
  @keyframes aura-zwerven-a {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    22% {
      transform: translate3d(-13rem, 8rem, 0) scale(1.14);
    }
    48% {
      transform: translate3d(-3rem, 19rem, 0) scale(0.9);
    }
    71% {
      transform: translate3d(-20rem, 6rem, 0) scale(1.08);
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes aura-zwerven-b {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    29% {
      transform: translate3d(17rem, -11rem, 0) scale(1.16);
    }
    57% {
      transform: translate3d(5rem, -22rem, 0) scale(0.88);
    }
    80% {
      transform: translate3d(21rem, -6rem, 0) scale(1.06);
    }
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  /* De regels van de kop.

     De ruime negatieve insets zijn er zodat de stokken onder de regel en het
     streepje eronder niet weggeknipt worden. inset(0) zou de p en de j afsnijden
     en de onderstreping helemaal verbergen. */
  .kop-regel {
    display: block;
    clip-path: inset(-14% -3% -22% -3%);
    animation: regel-op 820ms var(--ease-uit) both;
    animation-delay: calc(var(--r) * 130ms);
  }

  @keyframes regel-op {
    from {
      clip-path: inset(0 -3% 108% -3%);
      transform: translate3d(0, 0.42em, 0);
    }
  }

  /* Het streepje trekt zich pas na de tweede regel, anders staat het er al
     terwijl de tekst nog omhoog komt. */
  .hero-streep {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.14em;
    height: 3px;
    border-radius: 2px;
    background-color: var(--color-mint);
    transform: scaleX(0);
    transform-origin: left;
    animation: streep-in 760ms 980ms var(--ease-uit) forwards;
  }

  /* Gefaseerde entree. De H1 zit er bewust niet bij: dat is het LCP-element en
     een element met opacity 0 telt niet als geverfd, dus faden ervan stelt de
     LCP-meting uit. De kop staat er dus meteen, de rest schuift erbij. */
  .hero-in {
    animation: hero-in 620ms var(--ease-uit) both;
    animation-delay: calc(var(--in, 0) * 70ms + 60ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
    }
  }

  @keyframes streep-in {
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-raster,
    .hero-aura,
    .hero-in,
    .kop-regel {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
    .kop-regel {
      clip-path: none;
    }
    .hero-raster {
      opacity: 0.7;
    }
    .hero-streep {
      animation: none;
      transform: scaleX(1);
    }
    .hero-gloed {
      display: none;
    }
  }
</style>

<script>
  // 12 regels, alleen bij een muis, en gethrottled op de frame rate.
  // Zet twee CSS-variabelen, verder doet CSS het werk.
  if (window.matchMedia('(pointer: fine)').matches) {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (hero) {
      let wacht = false;
      hero.addEventListener('pointermove', (e) => {
        if (wacht) return;
        wacht = true;
        requestAnimationFrame(() => {
          const vak = hero.getBoundingClientRect();
          hero.style.setProperty('--muis-x', `${e.clientX - vak.left}px`);
          hero.style.setProperty('--muis-y', `${e.clientY - vak.top}px`);
          wacht = false;
        });
      });
    }
  }
</script>
