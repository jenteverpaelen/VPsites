---
import Base from '~/layouts/Base.astro';
import PaginaKop from '~/components/PaginaKop.astro';
import ContactCta from '~/components/ContactCta.astro';
import Zegel from '~/components/Zegel.astro';
import { bedrijf, telHref, mailHref, adresRegel } from '~/data/bedrijf';
import { kruimelSchema } from '~/lib/schema';

const kruimels = [{ naam: 'over', pad: '/over' }];

const feiten = [
  { label: 'Naam', waarde: bedrijf.persoon },
  { label: 'Werkt vanuit', waarde: bedrijf.adres.gemeente },
  { label: 'Sinds', waarde: String(bedrijf.startjaar) },
  { label: 'Vorm', waarde: 'Eenmanszaak in bijberoep' },
  { label: 'Ondernemingsnummer', waarde: bedrijf.ondernemingsnummer },
];
---

<Base
  titel="Over Jente Ver Paelen | VPsites"
  beschrijving="Ik maak websites in bijberoep, uit passie. Wie ik ben, hoe ik werk, en waar mijn grenzen liggen. Zonder verkooppraat."
  og="over"
  schema={[kruimelSchema(kruimels)]}
>
  <PaginaKop
    comment="wie er opneemt als je belt"
    titel="Dag, ik ben Jente."
    intro="Ik maak websites in bijberoep. Dat is geen tussenstap naar iets groters, het is precies wat het is. Hier staat wat je van mij mag verwachten, en wat niet."
    kruimels={kruimels}
  />

  <section class="sectie">
    <div class="container-vp">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <!-- Hier stond een staand vak van 4:5. Dat is een fotoplek, wat je er ook
             in zet, en Jente wil geen foto van zichzelf op de site. Dus is de
             plek zelf weg: deze kolom is nu alleen de feiten, op haarlijnen en
             zonder kader. Geen vorm die om een beeld vraagt.

             Sticky, want het is een naslagkolom naast een leeskolom. Zo staat het
             ondernemingsnummer nog in beeld terwijl je de tekst ernaast leest. -->
        <div class="lg:col-span-4">
          <div class="lg:sticky lg:top-28">
            <Zegel class="mb-10" />

            <dl class="border-t border-line">
              {
                feiten.map((feit) => (
                  <div class="border-b border-line py-4">
                    <dt class="text-sm text-faint">{feit.label}</dt>
                    <dd class="mt-1 font-display text-lg leading-snug">{feit.waarde}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>

        <!-- Ingekort van ongeveer 360 naar 150 woorden. Wat eruit ging waren de
             aanlopen en de herhaling, niet de inhoud: de vier bezwaren staan er
             alle vier nog. Dat is precies wat deze pagina moet doen, want wie
             hier komt zoekt geen verhaal maar een reden om te vertrouwen. -->
        <div class="prose-vp lg:col-span-8">
          <h2>Waarom ik hieraan begon</h2>
          <p>
            Ik bouw al jaren websites, eerst voor mezelf en daarna voor vrienden. Steeds
            kwam dezelfde vraag terug: iemand met een eigen zaak had een offerte van een
            paar duizend euro voor vier pagina's en vroeg zich af of dat normaal was. Het
            is wat de markt vraagt, maar niet wat het werk kost. Een bureau met twintig
            mensen heeft dat geld nodig. Ik niet.
          </p>

          <h2>Hoe ik werk</h2>
          <p>
            Een paar klanten per maand, niet meer. Vaste prijs voor we beginnen, en die
            verandert niet onderweg. Je ziet het ontwerp voor ik iets bouw en betaalt de
            helft pas bij oplevering. Ik bouw statisch, dus je site laadt in minder dan
            een seconde en er zijn geen plugins die stukgaan. Een onderhoudscontract heb
            je dus niet nodig, en ik verkoop er geen.
          </p>

          <h2>Waar mijn grenzen liggen</h2>
          <p>
            Dit is bijberoep. Bel je op dinsdagnamiddag, dan antwoord ik meestal pas
            's avonds. Geen webshops met honderden producten, geen projecten van maanden,
            niets waar een team voor nodig is. Vraag je me zoiets, dan zeg ik dat en
            verwijs ik je door.
          </p>

          <h2>Waarom je mij zou vertrouwen</h2>
          <p>
            Ik ben net begonnen, dus een lijst tevreden klanten heb ik niet. Wat ik wel
            heb: mijn naam, adres, ondernemingsnummer en gsm-nummer staan op deze site.
            Je domeinnaam komt op jouw naam, de bestanden krijg je mee, en je zit nergens
            aan vast. Deze site is verder het beste bewijs dat ik heb. Meet hem door op
            PageSpeed Insights.
          </p>
        </div>
      </div>

      <div class="mt-16 grid gap-4 rounded-vp border border-line bg-panel p-7 sm:grid-cols-3 md:p-8">
        <div>
          <span class="label-mono">Bellen</span>
          <a href={telHref} class="mt-2 flex min-h-11 items-center text-lg hover:text-mint">
            {bedrijf.telefoonWeergave}
          </a>
        </div>
        <div>
          <span class="label-mono">Mailen</span>
          <a href={mailHref} class="mt-2 flex min-h-11 items-center text-lg break-all hover:text-mint">
            {bedrijf.email}
          </a>
        </div>
        <div>
          <span class="label-mono">Adres</span>
          <address class="mt-2 flex min-h-11 items-center text-lg not-italic">{adresRegel}</address>
        </div>
      </div>
    </div>
  </section>

  <ContactCta />
</Base>
