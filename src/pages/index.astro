---
import Base from '~/layouts/Base.astro';
import Hero from '~/components/Hero.astro';
import Probleem from '~/components/Probleem.astro';
import Oogopslag from '~/components/Oogopslag.astro';
import PrijzenBlok from '~/components/PrijzenBlok.astro';
import Uitspraak from '~/components/Uitspraak.astro';
import WaaromGoedkoper from '~/components/WaaromGoedkoper.astro';
import SnelheidsRace from '~/components/SnelheidsRace.astro';
import WatIkNietDoe from '~/components/WatIkNietDoe.astro';
import Proces from '~/components/Proces.astro';
import WerkBlok from '~/components/WerkBlok.astro';
import OverKort from '~/components/OverKort.astro';
import Faq from '~/components/Faq.astro';
import ContactCta from '~/components/ContactCta.astro';

import { faqVoor } from '~/data/faq';
import { faqSchema, dienstenSchema } from '~/lib/schema';

const vragen = faqVoor('home');
---

<Base
  titel="Website laten maken vanaf €150 | VPsites"
  beschrijving="Snelle websites voor zelfstandigen in Vlaanderen. Vaste prijs vanaf €150, geen btw, geen abonnement. Klaar in 3 dagen tot een week. Prijzen staan online."
  og="home"
  schema={[faqSchema(vragen), ...dienstenSchema()]}
>
  <!-- Eén bord in plaats van dertien banden.

       De home was een verticale stapel volle secties, en dat is wat elke
       marketingpagina doet. Dit is een bord met panelen: je scant het, je ziet
       de prijs en de levertijd meteen naast elkaar, en je klikt door naar wat je
       nodig hebt. Dat past bij wat deze site verkoopt, want het hele argument is
       dat alles gewoon te zien is zonder dat je een offerte moet vragen.

       De tegels zijn 1, 2 of 3 kolommen breed en dat is met opzet ongelijk. Een
       raster waarin alles dezelfde maat heeft is weer een stapel, alleen dan in
       twee richtingen. -->
  <div class="container-app py-4 md:py-6">
    <div class="bord">
      <Hero />
      <Probleem />
      <Oogopslag />
      <PrijzenBlok kop="Wat het kost" />
      <Uitspraak />
      <WaaromGoedkoper />
      <WatIkNietDoe />
      <SnelheidsRace />
      <Proces />
      <WerkBlok />
      <OverKort />
      <Faq vragen={vragen} />
      <ContactCta />
    </div>
  </div>
</Base>
